# Vercel Cron sends this value as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Neon injects this when installed through the Vercel Marketplace.
DATABASE_URL=

# A persistent, authenticated cloud-browser CDP endpoint. Never paste browser
# cookies here. Sign in once in the provider's browser profile, including MFA.
BROWSER_WS_ENDPOINT=

# Optional for local development. Production uses Vercel's automatic OIDC token.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Conservative defaults. Raise only after checking Builder Center rules.
ARTICLES_PER_DAY=3
COMMENTS_PER_DAY=2
