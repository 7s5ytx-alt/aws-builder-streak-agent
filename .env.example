# Vercel Cron sends this value as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Neon injects this when installed through the Vercel Marketplace.
DATABASE_URL=

# Cloudflare Browser Run. Create a token limited to Browser Rendering: Edit.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# A base64-encoded, 32-byte key. It encrypts the Builder Center browser state
# before it is written to Neon. Generate it locally; never commit or share it.
AUTH_STATE_ENCRYPTION_KEY=

# A separate random value used only for the one-time Cloudflare Live View
# login/capture endpoint. Do not use CRON_SECRET for this.
SETUP_SECRET=

# Optional for local development. Production uses Vercel's automatic OIDC token.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Conservative defaults. Raise only after checking Builder Center rules.
ARTICLES_PER_DAY=3
COMMENTS_PER_DAY=2
