{
  "name": "aws-builder-streak-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "vercel dev",
    "local:run": "node scripts/local-run.mjs",
    "deploy": "vercel --prod",
    "cf:check": "node scripts/check-cloudflare.mjs",
    "capture:local": "node scripts/capture-local.mjs",
    "status": "node scripts/status.mjs",
    "inspect": "node scripts/inspect-pages.mjs",
    "alert:test": "node scripts/alert-test.mjs",
    "probe": "node scripts/probe-composer.mjs",
    "test:comment": "node --experimental-strip-types scripts/test-comment.ts",
    "probe:editor": "node --experimental-strip-types scripts/probe-editor.ts",
    "probe:search": "node --experimental-strip-types scripts/probe-search.ts",
    "test:search": "node --experimental-strip-types scripts/test-search.ts",
    "post:comment": "node --experimental-strip-types scripts/post-comment.ts",
    "test:composers": "node --experimental-strip-types scripts/test-composers.ts",
    "probe:wishlist": "node --experimental-strip-types scripts/probe-wishlist.ts",
    "test:wishlist": "node --experimental-strip-types scripts/test-wishlist.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "probe:create": "node --experimental-strip-types scripts/probe-create.ts",
    "test:create": "node --experimental-strip-types scripts/test-create.ts",
    "fix:wish": "node --experimental-strip-types scripts/fix-wish-service.ts",
    "verify:wish": "node --experimental-strip-types scripts/verify-wish.ts",
    "fix:tag": "node --experimental-strip-types scripts/fix-article-tag.ts",
    "smoke": "node scripts/smoke.mjs",
    "probe:profile": "node --experimental-strip-types scripts/probe-profile.ts",
    "test:proof": "node --experimental-strip-types scripts/test-proof.ts",
    "probe:badges": "node --experimental-strip-types scripts/probe-badges.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vercel": "^65.16.0"
  }
}
